# CodeGate Docker Production Environment Example Configuration
# Copy this file to .env.docker and update the values.

# ---------------------------------------------------------
# POSTGRESQL DATABASE
# ---------------------------------------------------------
POSTGRES_USER=codegate
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=codegate
# The database URL the backend uses to connect to Postgres
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---------------------------------------------------------
# FRONTEND SETTINGS
# ---------------------------------------------------------
# The URL where the frontend will call the backend API.
# Note: For Docker, this must remain localhost/127.0.0.1 from the browser's perspective.
VITE_CODEGATE_API_URL=http://127.0.0.1:8000/api/v1

# ---------------------------------------------------------
# BACKEND SECURITY & INTEGRATIONS
# ---------------------------------------------------------
# Allowed CORS origins for the backend
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Groq API Key (Runtime only)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=7890123
# Path to the mounted private key inside the backend container
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# (Optional) SMEE URL if using local webhook forwarding
SMEE_URL=https://smee.io/your_smee_channel
